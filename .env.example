# Server-side only. Never prefixed with NEXT_PUBLIC, so it cannot reach the browser.
# Production: https://api.storekit.site/v1 (note the /v1; the mobile app's EXPO_PUBLIC_API_URL has none).
API_BASE_URL=http://localhost:8787/v1

# Safe to expose.
NEXT_PUBLIC_SITE_URL=http://localhost:3002
NEXT_PUBLIC_APP_DEEP_LINK=storekit://payment-success
# Store listings. The Play URL is the one that matters first; iOS can stay unset until
# the app ships there, in which case the badge simply links nowhere.
NEXT_PUBLIC_PLAY_STORE_URL=https://play.google.com/store/apps/details?id=site.storekit.owner
NEXT_PUBLIC_APP_STORE_URL=https://apps.apple.com/app/storekit/id000000000
