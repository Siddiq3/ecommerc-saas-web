# Everything here is read on the server. Nothing needs a NEXT_PUBLIC_ prefix.

# The StoreKit API, including /v1. (The mobile app's EXPO_PUBLIC_API_URL has no /v1; the app adds it.)
API_BASE_URL=http://localhost:8787/v1

# This site's own address (used for page metadata and links). On Vercel it falls back to the deployment's address.
SITE_URL=http://localhost:3002
# Where the mobile app is opened from a payment page.
APP_DEEP_LINK=storekit://payment-success
# The root stores live under: {slug}.<this host>.
STOREFRONT_URL=https://storekit.site
# Store listings. Leave a link out until the app is published there; the badge then links nowhere.
PLAY_STORE_URL=https://play.google.com/store/apps/details?id=site.storekit.owner
# APP_STORE_URL=https://apps.apple.com/app/storekit/id000000000
